{
  "name": "atlas-ia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/static-pages.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests/browser/*.test.js",
    "check:budget": "node scripts/check-budget.mjs",
    "build:pages": "VITE_BASE_PATH=/atlas.ia/ npm run build",
    "test:pages": "node --test tests/pages/*.test.js"
  },
  "dependencies": {
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "vite": "8.3.7"
  }
}
